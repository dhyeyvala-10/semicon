  "cards": [
    { "dot": "emerald", "title": "Runs entirely in the browser", "items": [
      "One prerendered page; the app mounts client-only (ssr: false)",
      "No backend, API keys or runtime API calls; fonts and map data are bundled",
      "Scene code loads lazily from the same origin; journey scenes are prefetched in the background"
    ] },
    { "dot": "cyan", "title": "Simulation loop", "items": [
      "One rAF loop ticks the stage player, wafer twin, telemetry, FabSim, robot and control loops",
      "Scenes are pure functions of player.view (phase, t), so scrubbing and stepping always agree",
      "UI panels re-render at a fixed 2–20 Hz tick; no 60 fps state goes through React"
    ] },
    { "dot": "violet", "title": "Scroll story", "items": [
      "One section per journey stage (55); the section on the reading line is the active stage",
      "Scroll position inside a section scrubs that stage; the camera glides between its phase cues",
      "Scene changes wait for the scroll to settle, behind a black veil"
    ] },
    { "dot": "amber", "title": "Rendering budget", "items": [
      "Pixel ratio capped at 1.5 and adapted by a performance monitor, without shader recompiles",
      "Static machine parts are merged into one mesh per finish, with one shadow caster per model",
      "Only the active scene is mounted, chosen from stageId by the scene switcher"
    ] },
    { "dot": "rose", "title": "Boundaries and fallbacks", "items": [
      "No WebGL (or ?mode=2d): a 2D view draws the same engine state instead of the 3D renderer",
      "The remote assistant posts to NEXT_PUBLIC_ASSISTANT_ENDPOINT only when that is set; off by default",
      "?stage= deep links open Explore directly at that stage"
    ] }
  ]
